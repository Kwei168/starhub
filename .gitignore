*.pyc
.vercel/*
!.vercel/project.json
.vercel-tmp/
.deploy-tmp/
.vercel

# 构建期缓存（TTL 30 分钟，跨 run 基本全过期；仅本地构建加速用，不进 git/Vercel）
rss_cache.json
# 原子写的临时文件（进程中断可能残留）
*.tmp

# 对抗性审查/TDD 的临时测试与提取脚本（本地运行产物，不入库）
_rev*
_adv*
_agnes_batch_test.py
_check_js_temp.js
_fix_quotes.py
_gh_*
_check_*
_compare_*
_batch_*
_verify_*

# 构建中间产物（CI 生成，体积大，不进仓库）
daily_insight_snapshot.json
source_quality.json
rss_api_snapshot*.json
# 72h 文章历史改由 actions/cache 承载（此前提交进 git 会让每场构建多写一个 64MB blob）
rss_history.json
rss_history_*.json
rss_history_index.json

# 工具/IDE 本地产物
.workbuddy/
.zcode/
# Qoder（国内版）本地插件配置，repowiki 知识卡片除外
.qoder/settings.json
nul

# D1 嵌入向量缓存（~8MB/5000 条，CI 用 actions/cache 持久化，不进仓库）
emb_cache.json

# 跨场状态族（批 2）：这 7 个文件每场都被整份重写，实测合计 17.4 MiB/场永久进 git 历史。
# 跨场传递改由 actions/cache 的 starhub-state 族承载（update.yml 的 Restore/Save cross-build
# state cache 两步，判据 tests/rss_history/test_state_cache_wiring.py 钉住"两边必须都有"）。
# 逐名列举、不用通配：通配会把同名但确实该入库的东西一起吞掉。
hot_history.json
analysis_snapshot.json
translations.json
rss_trend_history.json
insight_tracking_history.jsonl
daily_insight_tracking_history.jsonl
daily_insight_history.json

# 每日深度洞察 FAISS 索引与 chunks（CI 构建产物，不进仓库）
daily_insight_faiss.index
daily_insight_chunks.json
daily_insight_vectors.npy
